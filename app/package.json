{
  "name": "petradms",
  "productName": "PetraDMS",
  "version": "1.5.0",
  "private": true,
  "description": "Offline PetraDMS backend for MM Traders",
  "author": "Petra",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test ../tests/*.test.js",
    "check": "node scripts/check.js",
    "bench": "node scripts/bench.js",
    "release:prepare": "node scripts/prepare-release.js",
    "dist": "npm run release:prepare && electron-builder --win --x64 --publish never",
    "test:frontend": "node renderer/tests/run.js",
    "probe": "node ../tools/real-backend-probe.js"
  },
  "build": {
    "appId": "com.petra.dms",
    "productName": "PetraDMS",
    "asar": true,
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "migrations/**",
      "seed/**",
      "contract/**",
      "package.json",
      "!renderer/tests/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "artifactName": "PetraDMS-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "PetraDMS-${version}-portable.exe"
    },
    "forceCodeSigning": false
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "exceljs": "4.4.0",
    "papaparse": "5.7.0",
    "read-excel-file": "9.3.14",
    "saxes": "6.0.0",
    "sql.js": "1.15.2",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "jsdom": "26.1.0"
  }
}
