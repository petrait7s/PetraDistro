{
 "_notation": "Leaf types: int, string, bool, money (int paisa), date (YYYY-MM-DD, business date), ts (ISO-8601 UTC), id (int). enum(a|b). 'T?' optional/nullable. '[T]' array. Names starting with a capital letter refer to this table. Anything else is an object literal.",
 "Page": {
  "limit": "int?",
  "cursor": "string?"
 },
 "PageOut": {
  "next_cursor": "string?",
  "total": "int"
 },
 "Qty": {
  "base": "int  (pcs for carton_pcs products, grams for by_kg)",
  "unit": "enum(pcs|g)",
  "cartons": "int",
  "pcs": "int  (remainder pcs; 0 for by_kg)",
  "kg": "string?  (decimal, 3 places; total weight, by_kg or when grams_per_carton known)",
  "text": {
   "bn": "string",
   "en": "string"
  }
 },
 "QtyIn": {
  "cartons": "int?",
  "pcs": "int?",
  "kg": "string?  (decimal string up to 3 places, only for by_kg products; backend parses exactly, UI never uses float)"
 },
 "DiscountIn": {
  "type": "enum(none|per_unit|percent|line)",
  "value": "int  (per_unit: paisa per carton or per kg; percent: basis points, 250 = 2.5%; line: paisa for the whole line)"
 },
 "Approval": {
  "token": "string  (from auth.requestApproval, single use)",
  "reason": "string"
 },
 "User": {
  "id": "id",
  "name": "string",
  "role": "enum(owner|manager)"
 },
 "Company": {
  "id": "id",
  "name": "string",
  "phone": "string?",
  "due": "money?  (owner only)"
 },
 "Product": {
  "id": "id",
  "sku": "string",
  "company_id": "id?",
  "company_name": "string?",
  "name": "string",
  "original_name": "string?",
  "sell_mode": "enum(carton_pcs|by_kg)",
  "pcs_per_carton": "int?",
  "pcs_per_dozen": "int?",
  "grams_per_carton": "int?",
  "list_price": "money  (per carton for carton_pcs, per kg for by_kg)",
  "cost_price": "money?  (OWNER ONLY, omitted for manager)",
  "margin_bp": "int?  (OWNER ONLY)",
  "max_discount": {
   "per_unit": "money",
   "percent_bp": "int?"
  },
  "min_sell_price": "money?  (OWNER ONLY)",
  "min_stock": "Qty?",
  "stock": "Qty",
  "stock_value": "money?  (OWNER ONLY, at lot cost)",
  "status": "enum(ok|low|out|near_expiry)",
  "next_expiry": "date?",
  "trend30": "[int]  (daily sold, base units, oldest first)",
  "assumed": {
   "pcs_per_carton": "bool",
   "cost_price": "bool"
  },
  "active": "bool"
 },
 "Lot": {
  "id": "id",
  "product_id": "id",
  "purchase_id": "id?",
  "received_date": "date",
  "expiry_date": "date?",
  "received": "Qty",
  "remaining": "Qty",
  "unit_cost": "money?  (OWNER ONLY)",
  "days_to_expiry": "int?"
 },
 "CustomerRow": {
  "id": "id",
  "name": "string",
  "owner": "string?",
  "phone": "string?",
