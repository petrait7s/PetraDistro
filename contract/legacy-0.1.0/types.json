  "created_by": "string",
  "allocations": "[{sale_id:id?, invoice_no:string?, opening:bool?, amount:money}]",
  "cheque": "{no:string, bank:string?, deposit_date:date?, status:enum(pending|cleared|bounced)}?",
  "reversal": "{by:string, reason:string, ts:ts}?"
 },
 "Invoice": {
  "sale": "Sale",
